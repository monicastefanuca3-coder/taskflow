<!DOCTYPE html>
<html lang="ro">
<head><%= include('partials/head', { pageTitle: 'Cont nou' }) %></head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <div class="auth-brand">
        <div class="brand-mark">T</div>
        <div class="brand-name">TaskFlow</div>
      </div>
      <h2 class="auth-title">Creează-ți un cont</h2>
      <p class="auth-subtitle">Durează mai puțin de un minut</p>

      <% if (error) { %>
        <div class="alert alert-error">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/register">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Email</label>
        <input type="text" name="email" placeholder="tu@companie.ro" required autofocus>
        <label>Parolă</label>
        <input type="password" name="password" placeholder="Alege o parolă" required>
        <button type="submit" class="full">Creează cont</button>
      </form>

      <div class="auth-switch">Ai deja cont? <a href="/login">Autentifică-te</a></div>
    </div>
  </div>
</body>
</html>
