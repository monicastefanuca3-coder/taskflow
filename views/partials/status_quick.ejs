<div class="status-quick">
  <form method="POST" action="/tasks/<%= task.id %>/status">
    <input type="hidden" name="status" value="open">
    <button type="submit" class="status-icon-btn <%= task.status === 'open' ? 'active st-open' : '' %>" title="Marchează ca open">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/></svg>
    </button>
  </form>
  <form method="POST" action="/tasks/<%= task.id %>/status">
    <input type="hidden" name="status" value="in-progress">
    <button type="submit" class="status-icon-btn <%= task.status === 'in-progress' ? 'active st-progress' : '' %>" title="Marchează ca in-progress">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
    </button>
  </form>
  <form method="POST" action="/tasks/<%= task.id %>/status">
    <input type="hidden" name="status" value="done">
    <button type="submit" class="status-icon-btn <%= task.status === 'done' ? 'active st-done' : '' %>" title="Marchează ca done">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
    </button>
  </form>
</div>
