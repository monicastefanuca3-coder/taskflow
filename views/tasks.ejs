<!DOCTYPE html>
<html lang="ro">
<head><%- include('partials/head', { pageTitle: 'Task-urile mele' }) %></head>
<body>
  <div class="app">
    <%- include('partials/sidebar', { user: user, active: 'tasks' }) %>

    <main class="main">
      <div class="content">
        <div class="page-header">
          <div>
            <h2>Task-urile mele</h2>
            <p>Organizează-ți activitatea zilnică într-un singur loc.</p>
          </div>
        </div>

        <form method="GET" action="/tasks" class="search-bar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" name="q" placeholder="Caută după titlu..." value="<%- search %>">
        </form>
        <!-- notă: rezultatul căutării e reafișat mai jos, intenționat neescapat (demo XSS reflectat) -->
        <% if (search) { %>
          <div class="alert alert-info">Rezultate pentru: <%- search %></div>
        <% } %>

        <div class="card">
          <h3 style="margin-top:0;">Task nou</h3>
          <form method="POST" action="/tasks">
            <label>Titlu</label>
            <input type="text" name="title" placeholder="ex: Pregătește prezentarea de sprint" required>
            <label>Descriere</label>
            <textarea name="description" placeholder="Detalii opționale..."></textarea>
            <button type="submit">Adaugă task</button>
          </form>

          <div class="divider"></div>

          <p class="muted-small" style="margin-bottom:10px;">Nu știi de unde să pornești? Deschide un șablon predefinit și copiază ce ai nevoie în descriere.</p>
          <form method="GET" action="/tasks/templates" target="_blank" style="display:flex; gap:10px; align-items:flex-end;">
            <div style="flex:1;">
              <label>Șablon</label>
              <select name="file">
                <option value="sprint-planning.txt">Planificare sprint</option>
                <option value="bug-report.txt">Raport de bug</option>
                <option value="daily-standup.txt">Daily standup</option>
                <option value="retro.txt">Retrospectivă</option>
              </select>
            </div>
            <button type="submit" class="secondary" style="margin-bottom:16px;">Deschide șablonul</button>
          </form>
        </div>

        <div class="row-between">
          <h3 style="margin-top:28px;">Toate task-urile (<%= tasks.length %>)</h3>
          <% if (tasks.length > 0) { %>
            <a href="/tasks/export-all" class="btn secondary small" style="margin-top:14px;">Exportă toate</a>
          <% } %>
        </div>
        <% if (tasks.length === 0) { %>
          <div class="empty-state">Nu ai niciun task încă. Adaugă primul mai sus.</div>
        <% } else { %>
          <div class="task-list">
            <% tasks.forEach(function(t) { %>
              <div class="task-row">
                <div class="task-row-main" style="display:flex; align-items:center; gap:12px;">
                  <%- include('partials/status_quick', { task: t }) %>
                  <div>
                    <a href="/tasks/<%= t.id %>" class="task-row-title"><%= t.title %></a>
                    <span class="badge <%= t.status === 'done' ? 'badge-done' : (t.status === 'in-progress' ? 'badge-progress' : 'badge-open') %>"><%= t.status %></span>
                  </div>
                </div>
                <div class="task-row-actions">
                  <a href="/tasks/<%= t.id %>" class="btn secondary small">Deschide</a>
                  <a href="/tasks/<%= t.id %>/edit" class="btn secondary small">Editează</a>
                  <form method="POST" action="/tasks/<%= t.id %>/delete">
                    <button type="submit" class="danger small">Șterge</button>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
