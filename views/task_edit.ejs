<!DOCTYPE html>
<html lang="ro">
<head><%- include('partials/head', { pageTitle: 'Editează — ' + task.title }) %></head>
<body>
  <div class="app">
    <%- include('partials/sidebar', { user: user, active: 'tasks' }) %>

    <main class="main">
      <div class="content">
        <a href="/tasks/<%= task.id %>" class="muted-small" style="display:inline-flex; align-items:center; gap:6px; margin-bottom:16px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          Înapoi la task
        </a>

        <div class="page-header">
          <div>
            <h2>Editează task</h2>
            <p>Actualizează detaliile task-ului.</p>
          </div>
        </div>

        <div class="card">
          <form method="POST" action="/tasks/<%= task.id %>/edit">
            <label>Titlu</label>
            <input type="text" name="title" value="<%= task.title %>" required>
            <label>Descriere</label>
            <textarea name="description"><%= task.description %></textarea>
            <label>Status</label>
            <select name="status">
              <option value="open" <%= task.status === 'open' ? 'selected' : '' %>>open</option>
              <option value="in-progress" <%= task.status === 'in-progress' ? 'selected' : '' %>>in-progress</option>
              <option value="done" <%= task.status === 'done' ? 'selected' : '' %>>done</option>
            </select>
            <div class="row-between">
              <button type="submit">Salvează modificările</button>
              <a href="/tasks/<%= task.id %>" class="btn secondary">Anulează</a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
