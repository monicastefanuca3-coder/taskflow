<!DOCTYPE html>
<html lang="ro">
<head><%- include('partials/head', { pageTitle: 'Profil' }) %></head>
<body>
  <div class="app">
    <%- include('partials/sidebar', { user: user, active: 'profile' }) %>

    <main class="main">
      <div class="content">
        <div class="page-header">
          <div>
            <h2>Profilul meu</h2>
            <p>Gestionează informațiile contului tău.</p>
          </div>
        </div>

        <div class="card row-between" style="margin-bottom:20px;">
          <div class="user-chip">
            <div class="avatar-xl" id="avatarBox">
              <img src="<%= user.avatar %>?v=<%= Date.now() %>" alt="Avatar"
                   data-fallback="<%= user.email.charAt(0) %>">
            </div>
            <div class="user-chip-text">
              <div class="user-chip-email" style="font-size:15px;"><%= user.email %></div>
              <span class="badge <%= user.role === 'admin' ? 'badge-admin' : 'badge-user' %>"><%= user.role === 'admin' ? 'Administrator' : 'Utilizator' %></span>
            </div>
          </div>
        </div>

        <div class="card" style="margin-bottom:20px;">
          <h3 style="margin-top:0;">Schimbă avatar</h3>
          <form method="POST" action="/profile/avatar" enctype="multipart/form-data">
            <label>Fișier imagine</label>
            <input type="file" name="avatar" required>
            <button type="submit">Încarcă</button>
          </form>
          <p class="muted-small">Acceptate: .png, .jpg, .jpeg, .gif, maximum 2 MB. Fișierul primește un nume generat automat.</p>
        </div>

      </div>
    </main>
  </div>
<script src="/js/app.js" defer></script></body>
</html>
